{
    "settingsSync.ignoredExtensions": [
      "vue.volar"
    ],
    "workbench.startupEditor": "none",
    "security.workspace.trust.untrustedFiles": "open",
    "files.eol": "\n",
    "terminal.explorerKind": "external",
    "terminal.integrated.cursorBlinking": true,
    "editor.unicodeHighlight.allowedLocales": {
      "ru": true
    },
    "[css]": {
      "editor.defaultFormatter": "vscode.css-language-features"
    },
    "editor.accessibilitySupport": "off",
    "editor.hover.enabled": false,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "security.workspace.trust.enabled": false,
    "editor.linkedEditing": true,
    "[vue]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "prettier.jsxSingleQuote": true,
    "git.openRepositoryInParentFolders": "never",
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features"
    },
    "prettier.singleQuote": true,
    "javascript.updateImportsOnFileMove.enabled": "never",
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "liveServer.settings.donotShowInfoMsg": true,
    "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.screenReaderAnnounceInlineSuggestion": true,
    "editor.codeActionsOnSave": {
      // "source.fixAll.eslint": true  
    },
    "editor.rulers": [
      100
    ],
    "workbench.iconTheme": "material-icon-theme",
    "tabnine.experimentalAutoImports": true,
    "editor.guides.bracketPairs": true,
    "editor.fontWeight": "normal",
    "vetur.format.options.tabSize": 2,
    "liveSassCompile.settings.autoprefix": [],
    "editor.guides.indentation": false,
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "liveSassCompile.settings.includeItems": [],
    "eslint.codeActionsOnSave.rules": null,
    "eslint.workingDirectories": [
      {
        "mode": "auto"
      }
    ],
    "workbench.settings.applyToAllProfiles": [
      
    ],
    "editor.fontLigatures": false,
    "[php]": {
      "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
      "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.associations": {
      "*.tpl": "php"
    },
    "editor.minimap.showSlider": "always",
    "githubPullRequests.pullBranch": "never",
    "launch": {
      "configurations": [],
      "compounds": []
    },
    "prettier.printWidth": 100,
    "terminal.integrated.defaultLocation": "editor",
    "liveSassCompile.settings.showOutputWindowOn": "None",
    "diffEditor.ignoreTrimWhitespace": false,
    "git.confirmSync": false,
    "editor.fontSize": 13,
    "workbench.editorAssociations": {
      "*.xlsx": "default"
    },
    "intelephense.environment.phpVersion": "8.3.17",
    "vetur.ignoreProjectWarning": true,
    "githubPullRequests.createOnPublishBranch": "never",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500000,
    "workbench.colorTheme": "JetBrains Darcula Theme",
    "security.allowedUNCHosts": [
      "wsl.localhost"
    ],
    "settingsSync.keybindingsPerPlatform": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "workbench.colorCustomizations": {
      "[Darcula]": {
        "sideBar.background": "#3f3f45",
        "editor.background": "#3a3a3a",
        "breadcrumb.background": "#000000",
      }
    },
    "gitlens.views.commits.files.layout": "tree",
    "vue.server.hybridMode": true,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.autohide": true,
    "editor.minimap.maxColumn": 110,
    "editor.maxTokenizationLineLength": 500,
    "editor.scrollbar.horizontalScrollbarSize": 30,
    "editor.suggestLineHeight": 8,
    "editor.lineHeight": 14,
    "explorer.excludeGitIgnore": true,
  "git.enabled": true,
  "explorer.confirmDelete": false
  }